# Runtime
ENVIRONMENT=local
AI_PROVIDER=demo
AI_MODEL=gpt-5-mini
MAX_OUTPUT_TOKENS=400
CONTACT_EMAIL=s.szarpak@officessai.com
DATA_DIR=data

# OpenAI direct. Keep server-side only.
OPENAI_API_KEY=

# Azure OpenAI / Microsoft Foundry Responses API.
# Example: https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=

# Optional SMTP notification. Leads are always stored in data/leads.sqlite3 first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional Gemini integration for future adapters. Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=
